.timeline::before {
  content: '';
  position: absolute;
  left: 10px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--accent);
}

/* Individual timeline item */
.timeline-item {
  position: relative;
  margin-bottom: 30px;
  cursor: pointer;
}

/* Date label */
.timeline-date {
  font-weight: bold;
  color: var(--accent);
  margin-bottom: 5px;
}

/* Card content */
.timeline-content {
  background: var(--bg-card);
  padding: 15px;
  border-radius: 8px;
  transition: transform 0.3s, box-shadow 0.3s;
}

/* Hover effect */
.timeline-content:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 15px rgba(0,0,0,0.3);
} 

/* skill */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.skill-card {
  background: var(--bg-card);
  border-radius: 16px;
  padding: 10px;
  text-align: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  transition: transform 0.3s, box-shadow 0.3s;
}

.skill-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.3);
}

.skill-icon {
  font-size: 2.5rem;
  margin-bottom: 10px;
  color: var(--accent);
}

.skill-bar {
  background: #2c2c2c;
  border-radius: 8px;
  height: 10px;
  width: 100%;
  margin: 10px 0;
  overflow: hidden;
}

.skill-bar span {
  display: block;
  height: 100%;
  width: 0;
  background-color: var(--accent);
  transition: width 1.5s ease-in-out;
}

.skill-percent {
  font-weight: 600;
  color: var(--accent-soft);
}

